# Sanity project (the structured dataset)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Project tokens: Viewer for reads (incl. Content Release versions), Editor for writing rulings back
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
# Sanity Context (organisation-scoped)
SANITY_ORGANIZATION_ID=
SANITY_CONTEXT_TOKEN=          # org token: Context Viewer is enough for the MCP endpoints
SANITY_CONTEXT_EDITOR_TOKEN=   # org token with Context Editor: Knowledge Base issues + Insights (defaults to the one above)
SANITY_MCP_CATALOG=clockwrit-catalog
SANITY_MCP_KNOWLEDGE=clockwrit-sources
SANITY_KNOWLEDGE_BASE_ID=
# Any OpenAI-compatible chat endpoint with tool calling
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Lets a reviewer approve rulings from the public desk without a Sanity login
REVIEWER_PASSCODE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
